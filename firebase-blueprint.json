{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profiles, progress metrics, and integrated cloud backups.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "photoURL": { "type": "string", "maxLength": 512 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "oracleProfile": { "type": "object" },
        "sanctuary_chats": { "type": "array" },
        "sanctuaryJournals": { "type": "array" },
        "sanctuaryXP": { "type": "integer" }
      },
      "required": ["uid"]
    },
    "KeepNote": {
      "title": "KeepNote",
      "description": "Google Keep synchronized personal note in Sanctuary",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 512 },
        "content": { "type": "string", "maxLength": 10000 },
        "color": { "type": "string", "maxLength": 32 },
        "isPinned": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string", "maxLength": 64 } },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 },
        "syncedToDriveId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "userId", "title", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User credentials, custom Greek-mythological guides profiles, and complete journaling history."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "KeepNote",
      "description": "Personal Google Keep notes stored persistently in Firestore."
    }
  }
}
