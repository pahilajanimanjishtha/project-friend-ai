rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net - Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Safety Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 3. User Entity Validation Blueprint
    function isValidUser(data) {
      return data.uid is string 
        && data.uid.size() <= 128
        && (!('email' in data) || (data.email is string && data.email.size() <= 128))
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64))
        && (!('sanctuaryXP' in data) || (data.sanctuaryXP is int));
    }

    // 4. Secure Users Collection Matches
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      allow create: if isOwner(userId) 
        && isValidId(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUser(request.resource.data)
        && request.resource.data.uid == userId;

      allow delete: if isOwner(userId);

      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
