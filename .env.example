# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: The secret password to access the sanctuary administration backend panel.
# Defaults to "admin123" if not defined.
ADMIN_PASSWORD=

# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps geo-tagging. Exposes the map view.
GOOGLE_MAPS_PLATFORM_KEY=

# ─── Tavus Conversational Video API (Required for /chat live video call) ───
# Sign up at https://app.tavus.io to obtain these credentials.

# TAVUS_API_KEY: Your Tavus API secret key. MUST remain server-side only.
TAVUS_API_KEY=

# TAVUS_PERSONA_ID: The AI persona that drives Nova's conversation.
# Go to app.tavus.io → Personas and copy the persona ID.
TAVUS_PERSONA_ID=

# TAVUS_REPLICA_ID: (Optional) Specific avatar replica for Nova's appearance.
# Leave blank to use the persona default.
TAVUS_REPLICA_ID=
